# Copy to .env.local for local development. Never commit real values.

# Postgres connection string. Neon in production, a local Postgres for development.
DATABASE_URL=postgres://bowerbird:bowerbird@localhost:5432/bowerbird
# The app's public address, used in sign-in links and passkeys.
APP_URL=http://localhost:3000
# Signs session cookies. 32 random bytes, base64 (openssl rand -base64 32).
SESSION_SECRET=
# Encrypts bank links and keys at rest with AES-256-GCM. 32 random bytes, base64.
ENCRYPTION_KEY=
# Shared secret Vercel Cron sends to /api/cron/sync.
CRON_SECRET=
# SMTP server for emailed sign-in links (for example smtp.gmail.com).
SMTP_HOST=
# SMTP port, 465 for TLS or 587 for STARTTLS.
SMTP_PORT=465
# SMTP user name, usually the sending email address.
SMTP_USER=
# SMTP password, for Gmail an app password.
SMTP_PASS=
# The From line on sign-in emails, for example "Bowerbird <you@gmail.com>".
SMTP_FROM=
# Web Push public key (phase 2), from npx web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
# Web Push private key (phase 2).
VAPID_PRIVATE_KEY=
# Web Push contact, a mailto: address (phase 2).
VAPID_SUBJECT=
